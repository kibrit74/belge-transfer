# Neon: uygulama için pooled, migration için direct bağlantıyı kullanın.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-rotated-secret
GOOGLE_REDIRECT_URI=http://localhost:5704/api/auth/google/callback

FRONTEND_ORIGIN=http://localhost:5173
PORT=5704
NODE_ENV=development

# İlk kurulum ve kurtarma için super admin e-postaları (virgülle ayırın).
# Bu liste yalnız sunucu ortamında tutulmalı; VITE_ öneki kullanmayın.
VAULTDROP_SUPER_ADMIN_EMAILS=admin@example.com

# Deneysel aktarım kapıları: gerçek cihaz kabul formları tamamlanmadan açmayın.
VITE_ENABLE_NEARBY=false
VITE_ENABLE_LIVE_QR_10MIB=false
VITE_ENABLE_LIVE_QR_FAST=false

# Neon Managed Auth (gizli değildir)
VITE_NEON_AUTH_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
